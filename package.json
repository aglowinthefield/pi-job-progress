{
  "name": "pi-job-progress",
  "version": "0.1.0",
  "description": "Live progress bars in pi for long background jobs, read from their log files.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^24.19.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typebox": "^1.3.27"
  },
  "scripts": {
    "typecheck": "tsrs -p .",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt"
  }
}
